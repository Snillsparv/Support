<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/alarm_background_gradient"
    tools:context=".ui.AlarmActivity">

    <!-- Top decoration -->
    <View
        android:id="@+id/topDecoration"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/circle_decoration"
        android:alpha="0.2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="-50dp" />

    <!-- Small decoration -->
    <View
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/circle_decoration"
        android:alpha="0.15"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="30dp"
        android:layout_marginTop="80dp" />

    <!-- Character container -->
    <FrameLayout
        android:id="@+id/characterContainer"
        android:layout_width="220dp"
        android:layout_height="220dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/messageCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.3">

        <!-- Glow effect behind character -->
        <View
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            android:background="@drawable/character_glow"
            android:alpha="0.6" />

        <!-- Character body -->
        <ImageView
            android:id="@+id/ivCharacter"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:src="@drawable/character_body"
            android:contentDescription="@string/cd_character" />

        <!-- Waving hand -->
        <ImageView
            android:id="@+id/ivWaveHand"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="35dp"
            android:layout_marginEnd="5dp"
            android:src="@drawable/character_wave"
            android:contentDescription="@null"
            android:transformPivotX="27dp"
            android:transformPivotY="45dp" />

    </FrameLayout>

    <!-- Speech bubble / Message card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/messageCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/characterContainer"
        app:layout_constraintBottom_toTopOf="@id/buttonContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingVertical="32dp"
            android:gravity="center">

            <!-- Bell icon -->
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_notification"
                app:tint="@color/primary"
                android:contentDescription="@null" />

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/alarm_title"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.05" />

            <!-- Reminder message -->
            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textSize="26sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.3"
                tools:text="Möte med teamet kl 10:00" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Button container -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Dismiss button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDismiss"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/dismiss_alarm"
            android:textSize="18sp"
            android:textAllCaps="false"
            app:cornerRadius="32dp"
            app:backgroundTint="@color/white"
            android:textColor="@color/primary"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart"
            app:iconTint="@color/primary"
            app:iconPadding="12dp"
            android:elevation="8dp" />

        <!-- Snooze button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSnooze"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="Påminn om 5 min"
            android:textSize="14sp"
            android:textAllCaps="false"
            app:cornerRadius="24dp"
            style="@style/Widget.Material3.Button.TextButton"
            android:textColor="@color/white"
            app:icon="@drawable/ic_snooze"
            app:iconGravity="textStart"
            app:iconTint="@color/white"
            app:rippleColor="#33FFFFFF" />

    </LinearLayout>

    <!-- Bottom decoration -->
    <View
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@drawable/circle_decoration"
        android:alpha="0.15"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="-30dp"
        android:layout_marginBottom="120dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
