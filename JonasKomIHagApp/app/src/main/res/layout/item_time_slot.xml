<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardTimeSlot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:paddingVertical="16dp"
        android:paddingEnd="16dp"
        android:paddingStart="4dp">

        <!-- Current time indicator -->
        <View
            android:id="@+id/currentTimeIndicator"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:background="@drawable/current_time_indicator"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:visibility="visible" />

        <!-- Time container -->
        <LinearLayout
            android:id="@+id/timeContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="12dp"
            android:minWidth="56dp"
            app:layout_constraintStart_toEndOf="@id/currentTimeIndicator"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Time label -->
            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                tools:text="09:30" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:id="@+id/divider"
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:layout_marginStart="16dp"
            android:background="@color/divider"
            app:layout_constraintStart_toEndOf="@id/timeContainer"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Reminder content -->
        <LinearLayout
            android:id="@+id/reminderContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@id/divider"
            app:layout_constraintEnd_toStartOf="@id/indicatorContainer"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Reminder message -->
            <TextView
                android:id="@+id/tvReminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.2"
                tools:text="Möte med teamet om projektplanering" />

            <!-- Empty state hint -->
            <TextView
                android:id="@+id/tvEmptyHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tryck för att lägga till"
                android:textSize="14sp"
                android:textColor="@color/text_hint"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- Indicator icons -->
        <LinearLayout
            android:id="@+id/indicatorContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/ivNotification"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_notification"
                android:visibility="gone"
                android:contentDescription="@string/cd_notification"
                android:background="@drawable/indicator_background"
                android:padding="3dp"
                app:tint="@color/primary"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/ivAlarm"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_alarm"
                android:visibility="gone"
                android:contentDescription="@string/cd_alarm"
                android:background="@drawable/indicator_background_alarm"
                android:padding="3dp"
                app:tint="@color/accent"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/ivSpeaker"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_speaker"
                android:visibility="gone"
                android:contentDescription="@string/cd_speaker"
                android:background="@drawable/indicator_background_speak"
                android:padding="3dp"
                app:tint="@color/secondary"
                tools:visibility="visible" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
